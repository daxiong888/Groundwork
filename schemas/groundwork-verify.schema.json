{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.dev/schemas/groundwork-verify.schema.json",
  "title": "Groundwork Verify Score Schema",
  "description": "Product schema for scope-first verify outputs and claim-to-evidence scoring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "verify_scope_present",
    "evidence_present",
    "evidence_sources",
    "claim_evidence_map",
    "unverified_claims",
    "overall_verdict",
    "checker_results"
  ],
  "properties": {
    "metadata": {
      "$ref": "groundwork-common.schema.json#/$defs/score_metadata"
    },
    "verify_scope_present": {
      "type": "boolean"
    },
    "evidence_present": {
      "type": "boolean"
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/evidence_source"
      },
      "uniqueItems": true
    },
    "claim_evidence_map": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim_evidence"
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
      }
    },
    "overall_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/overall_verdict"
    },
    "checker_results": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/checker_result"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
      }
    },
    "extensions": {
      "$ref": "groundwork-common.schema.json#/$defs/extension_map"
    }
  },
  "$defs": {
    "claim_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "verdict",
        "evidence_sources"
      ],
      "properties": {
        "claim": {
          "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
        },
        "verdict": {
          "$ref": "groundwork-common.schema.json#/$defs/dimension_verdict"
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "$ref": "groundwork-common.schema.json#/$defs/evidence_source"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
          }
        },
        "extensions": {
          "$ref": "groundwork-common.schema.json#/$defs/extension_map"
        }
      }
    }
  }
}
