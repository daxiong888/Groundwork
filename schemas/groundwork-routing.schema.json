{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.dev/schemas/groundwork-routing.schema.json",
  "title": "Groundwork Routing Score Schema",
  "description": "Product schema for trace-ready routing verdicts and schema-ready execution primitive decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "expected_route",
    "actual_route",
    "acceptable_routes",
    "forbidden_routes",
    "route_boundary",
    "routing_verdict",
    "overall_verdict",
    "checker_results"
  ],
  "properties": {
    "metadata": {
      "$ref": "groundwork-common.schema.json#/$defs/score_metadata"
    },
    "expected_route": {
      "$ref": "groundwork-common.schema.json#/$defs/workflow_route"
    },
    "actual_route": {
      "$ref": "groundwork-common.schema.json#/$defs/workflow_route"
    },
    "acceptable_routes": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/workflow_route"
      },
      "uniqueItems": true
    },
    "forbidden_routes": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/workflow_route"
      },
      "uniqueItems": true
    },
    "route_boundary": {
      "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
    },
    "routing_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/dimension_verdict"
    },
    "expected_execution_primitive": {
      "$ref": "groundwork-common.schema.json#/$defs/execution_primitive"
    },
    "selected_execution_primitive": {
      "$ref": "groundwork-common.schema.json#/$defs/execution_primitive"
    },
    "acceptable_execution_primitives": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/execution_primitive"
      },
      "uniqueItems": true
    },
    "forbidden_execution_primitives": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/execution_primitive"
      },
      "uniqueItems": true
    },
    "checker_results": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/checker_result"
      }
    },
    "overall_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/overall_verdict"
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
      }
    },
    "extensions": {
      "$ref": "groundwork-common.schema.json#/$defs/extension_map"
    }
  }
}
