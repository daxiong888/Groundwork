{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.dev/schemas/groundwork-review.schema.json",
  "title": "Groundwork Review Lens Score Schema",
  "description": "Product schema for review lens outputs. Review is schema and lens vocabulary only; it is not a public Groundwork skill.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "review_lens",
    "target_reader_present",
    "scope_present",
    "findings",
    "overall_verdict",
    "checker_results"
  ],
  "properties": {
    "metadata": {
      "$ref": "groundwork-common.schema.json#/$defs/score_metadata"
    },
    "review_lens": {
      "type": "string",
      "enum": [
        "prd",
        "document",
        "contract",
        "implementation",
        "uat",
        "ui",
        "git_boundary",
        "routing",
        "closeout",
        "unknown"
      ]
    },
    "target_reader_present": {
      "type": "boolean"
    },
    "scope_present": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review_finding"
      }
    },
    "overall_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/overall_verdict"
    },
    "checker_results": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/checker_result"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
      }
    },
    "extensions": {
      "$ref": "groundwork-common.schema.json#/$defs/extension_map"
    }
  },
  "$defs": {
    "review_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "summary",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
        },
        "severity": {
          "$ref": "groundwork-common.schema.json#/$defs/severity"
        },
        "summary": {
          "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved",
            "not_applicable",
            "unknown"
          ]
        },
        "fix_locus": {
          "$ref": "groundwork-common.schema.json#/$defs/fix_locus"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
          }
        },
        "extensions": {
          "$ref": "groundwork-common.schema.json#/$defs/extension_map"
        }
      }
    }
  }
}
