{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.dev/schemas/groundwork-closeout.schema.json",
  "title": "Groundwork Closeout Score Schema",
  "description": "Product schema for closeout scoring. Merge recommendations must not be positive unless evidence, git boundary, review status, and known merge source requirements are satisfied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "task_verdict",
    "evidence_present",
    "git_boundary_present",
    "review_findings_status",
    "merge_source_known",
    "merge_recommendation",
    "cleanup_decision",
    "forbidden_merge_recommendation_detected",
    "overall_verdict",
    "checker_results"
  ],
  "properties": {
    "metadata": {
      "$ref": "groundwork-common.schema.json#/$defs/score_metadata"
    },
    "task_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/overall_verdict"
    },
    "evidence_present": {
      "type": "boolean"
    },
    "git_boundary_present": {
      "type": "boolean"
    },
    "review_findings_status": {
      "type": "string",
      "enum": [
        "no_findings",
        "open_findings",
        "resolved",
        "not_reviewed",
        "unknown"
      ]
    },
    "merge_source_known": {
      "type": "boolean"
    },
    "merge_recommendation": {
      "type": "string",
      "enum": [
        "merge",
        "do_not_merge",
        "defer",
        "not_applicable",
        "unknown"
      ]
    },
    "cleanup_decision": {
      "type": "string",
      "enum": [
        "cleanup",
        "preserve",
        "defer",
        "not_applicable",
        "unknown"
      ]
    },
    "forbidden_merge_recommendation_detected": {
      "type": "boolean"
    },
    "overall_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/overall_verdict"
    },
    "checker_results": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/checker_result"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
      }
    },
    "extensions": {
      "$ref": "groundwork-common.schema.json#/$defs/extension_map"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "merge_recommendation": {
            "const": "merge"
          }
        },
        "required": [
          "merge_recommendation"
        ]
      },
      "then": {
        "properties": {
          "evidence_present": {
            "const": true
          },
          "git_boundary_present": {
            "const": true
          },
          "review_findings_status": {
            "enum": [
              "no_findings",
              "resolved"
            ]
          },
          "merge_source_known": {
            "const": true
          },
          "forbidden_merge_recommendation_detected": {
            "const": false
          }
        }
      }
    }
  ]
}
