{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.dev/schemas/groundwork-eval-score.schema.json",
  "title": "Groundwork Eval Score Schema",
  "description": "Product wrapper schema for per-case trace-first eval scoring. This schema is for score artifacts only and does not imply runtime, cache, release, UAT, or customer readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "case_id",
    "suite",
    "score_subject",
    "output_contract_verdict",
    "evidence_verdict",
    "behavior_verdict",
    "routing_verdict",
    "host_preemption_verdict",
    "overall_verdict",
    "checker_results"
  ],
  "properties": {
    "metadata": {
      "$ref": "groundwork-common.schema.json#/$defs/score_metadata"
    },
    "case_id": {
      "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
    },
    "suite": {
      "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
    },
    "expected_skill": {
      "$ref": "groundwork-common.schema.json#/$defs/workflow_route"
    },
    "triggered_skill": {
      "$ref": "groundwork-common.schema.json#/$defs/workflow_route"
    },
    "expected_execution_primitive": {
      "$ref": "groundwork-common.schema.json#/$defs/execution_primitive"
    },
    "selected_execution_primitive": {
      "$ref": "groundwork-common.schema.json#/$defs/execution_primitive"
    },
    "output_contract_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/dimension_verdict"
    },
    "evidence_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/dimension_verdict"
    },
    "behavior_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/dimension_verdict"
    },
    "routing_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/dimension_verdict"
    },
    "host_preemption_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/dimension_verdict"
    },
    "overall_verdict": {
      "$ref": "groundwork-common.schema.json#/$defs/overall_verdict"
    },
    "failure_type": {
      "type": "string",
      "enum": [
        "forbidden_route",
        "invalid_host_preemption",
        "output_contract_failure",
        "evidence_failure",
        "behavior_failure",
        "direct_fallback_ceremony",
        "premature_implementation",
        "legacy_runtime_check",
        "codex_timeout",
        "codex_exit",
        "schema_validation_error",
        "unclassified",
        "none",
        "unknown"
      ]
    },
    "fix_locus": {
      "$ref": "groundwork-common.schema.json#/$defs/fix_locus"
    },
    "checker_results": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/checker_result"
      }
    },
    "score_subject": {
      "type": "string",
      "enum": [
        "verify",
        "review",
        "routing",
        "closeout",
        "generic"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "groundwork-common.schema.json#/$defs/non_empty_string"
      }
    },
    "extensions": {
      "$ref": "groundwork-common.schema.json#/$defs/extension_map"
    }
  }
}
