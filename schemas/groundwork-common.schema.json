{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.dev/schemas/groundwork-common.schema.json",
  "title": "Groundwork Common Eval Schema Definitions",
  "description": "Shared JSON Schema 2020-12 definitions for Groundwork trace-first eval verdicts, routing, execution primitives, evidence, blocking, checker results, and score metadata.",
  "$comment": "This file is a shared $defs library. Product schemas should $ref these definitions rather than treating this as the primary score instance schema.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_name": {
      "const": "groundwork-common"
    }
  },
  "$defs": {
    "overall_verdict": {
      "type": "string",
      "enum": [
        "pass",
        "partial",
        "fail",
        "blocked"
      ]
    },
    "dimension_verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "blocked",
        "not_applicable"
      ]
    },
    "workflow_route": {
      "type": "string",
      "enum": [
        "dispatch",
        "to-prd",
        "to-issues",
        "triage",
        "write-plan",
        "prototype",
        "implement",
        "verify",
        "handoff",
        "direct",
        "runtime-safety-gate",
        "unknown"
      ]
    },
    "execution_primitive": {
      "type": "string",
      "enum": [
        "local_direct",
        "local_with_artifact",
        "worktree_isolated",
        "worktree_review_only",
        "automation_candidate",
        "subagent_review_candidate",
        "blocked_no_execution",
        "not_applicable",
        "unknown"
      ]
    },
    "evidence_source": {
      "type": "string",
      "enum": [
        "conversation",
        "accepted_prd",
        "local_artifact",
        "external_issue",
        "pull_request",
        "source_code",
        "test_evidence",
        "runtime_evidence",
        "state_md",
        "git_boundary",
        "browser_evidence",
        "cache_equivalence",
        "installed_plugin_cache",
        "user_confirmation",
        "mixed",
        "none",
        "unknown"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3",
        "info",
        "none",
        "unknown"
      ]
    },
    "blocked_reason": {
      "type": "string",
      "enum": [
        "missing_source_truth",
        "missing_user_decision",
        "missing_approval",
        "missing_runtime",
        "missing_test_seam",
        "schema_validation_error",
        "unsupported_token",
        "unsafe_git_topology",
        "permission_denied",
        "external_dependency_unavailable",
        "timeout",
        "secrets_or_pii_risk",
        "out_of_scope",
        "unknown"
      ]
    },
    "fix_locus": {
      "type": "string",
      "enum": [
        "routing_surface",
        "runtime_safety_gate",
        "skill_output_contract",
        "evidence_collection",
        "requirement_state_gate",
        "direct_fallback_boundary",
        "runtime_environment",
        "runtime_verdict",
        "behavior_guardrail",
        "artifact_policy",
        "git_boundary",
        "schema_contract",
        "fixture_contract",
        "unknown"
      ]
    },
    "checker_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "extension_map": {
      "type": "object",
      "description": "Explicit extension point for experimental or product-specific fields. Stable fields should be promoted into named schema definitions instead of remaining here.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
      },
      "additionalProperties": true
    },
    "checker_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checker_id",
        "verdict"
      ],
      "properties": {
        "checker_id": {
          "$ref": "#/$defs/checker_id"
        },
        "verdict": {
          "$ref": "#/$defs/dimension_verdict"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "blocked_reason": {
          "$ref": "#/$defs/blocked_reason"
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/non_empty_string"
          }
        },
        "fix_locus": {
          "$ref": "#/$defs/fix_locus"
        },
        "extensions": {
          "$ref": "#/$defs/extension_map"
        }
      }
    },
    "score_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_name"
      ],
      "properties": {
        "schema_version": {
          "const": "2020-12"
        },
        "schema_name": {
          "$ref": "#/$defs/non_empty_string"
        },
        "score_version": {
          "$ref": "#/$defs/non_empty_string"
        },
        "suite": {
          "$ref": "#/$defs/non_empty_string"
        },
        "case_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "run_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_source"
          },
          "uniqueItems": true
        },
        "extensions": {
          "$ref": "#/$defs/extension_map"
        }
      }
    }
  }
}
