  "prompt_precedence": ["direct_plain_text", "implement_bypass", "raw_prd_intake", "handoff", "closeout_triage", "plan_then_implement", "ordinary_audit_direct", "evidence_verify", "write_plan", "issue_readiness_triage", "explicit_audit_dispatch", "ready_package_dispatch", "implement", "fallback_markers", "direct_fallback"],
