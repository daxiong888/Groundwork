    "dispatch": {"accepted_pre_states": ["issue_ready", "implementation_ready", "verified"], "produced_states": ["issue_ready", "implementation_ready", "blocked"], "description_fragments": ["Package-only routing", "Not for execution", "ordinary audits"]},
    "wiki": {"accepted_pre_states": ["prd_accepted", "issue_ready", "implementation_ready", "verified", "blocked"], "produced_states": ["same", "blocked"], "description_fragments": ["Explicit project-level LLM Wiki", "Not for direct answers", "implementation"]}
